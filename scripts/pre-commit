#!/bin/sh
# Pre-commit: build + format + lint.
# For the full sweep (including tests) run: make verify-full
set -e
go build ./...

# Resolve golangci-lint: PATH first, then the Go tool bin dir ($GOBIN, else
# $GOPATH/bin, else ~/go/bin).
#
# Hooks do NOT run with your interactive PATH. They inherit the environment of
# whatever invoked git — an editor, a GUI client, an agent daemon — and that
# environment routinely lacks ~/go/bin, which is exactly where `go install`
# puts golangci-lint. Without this fallback, `make install-hooks` could produce
# a hook that fails on every single commit while `golangci-lint` worked fine in
# the terminal. Same search order as internal/quality/golangcilint.LookBinary,
# so the hook and the daemon's post-write analyser agree on the binary.
GOLANGCI_LINT="$(command -v golangci-lint 2>/dev/null || true)"
if [ -z "$GOLANGCI_LINT" ]; then
	for dir in "$GOBIN" "${GOPATH:-$HOME/go}/bin" "$HOME/go/bin"; do
		if [ -n "$dir" ] && [ -x "$dir/golangci-lint" ]; then
			GOLANGCI_LINT="$dir/golangci-lint"
			break
		fi
	done
fi
if [ -z "$GOLANGCI_LINT" ]; then
	echo "pre-commit: golangci-lint not found on PATH, in \$GOBIN, or in \$GOPATH/bin." >&2
	echo "  install it (https://golangci-lint.run/welcome/install/), or set GOBIN," >&2
	echo "  or commit with --no-verify if you must and run 'make verify-full' before pushing." >&2
	exit 1
fi

# Warn when this binary disagrees with the version CI pins.
#
# A binary newer than the pin brings newer gofumpt rules with it, so it flags
# files the commit never touched. When this hook ran `--fix` it REWROTE them
# silently, and they sat as unstaged modifications until someone's `git add -A`
# swept them into an unrelated PR (two test files drifted exactly so). The hook
# now only checks, so the drift fails the commit instead — and this warning
# says why a file you never edited is suddenly unformatted.
#
# A warning, not a failure. Being mid-upgrade is legitimate and blocking every
# commit over it would be disproportionate — the defect was that the drift was
# SILENT, and saying so out loud is what fixes that. Every step is guarded
# against `set -e`: an unreadable or restructured workflow file must not be
# able to block a commit.
# The version character class stops at whitespace AND at '#', so a trailing
# comment written without a space before it (`v2.13.0# pinned`) yields the
# version rather than "2.13.0#" — a WRONG value would warn on a matching pair,
# where an empty one merely skips the check.
PINNED_LINT_VERSION="$(sed -n 's/^[[:space:]]*GOLANGCI_LINT_VERSION:[[:space:]]*v\{0,1\}\([0-9][^[:space:]#]*\).*/\1/p' .github/workflows/ci.yml 2>/dev/null | head -1 || true)"
LOCAL_LINT_VERSION="$("$GOLANGCI_LINT" --version 2>/dev/null | sed -n 's/.*has version v\{0,1\}\([0-9][^[:space:]]*\).*/\1/p' | head -1 || true)"
if [ -n "$PINNED_LINT_VERSION" ] && [ -n "$LOCAL_LINT_VERSION" ] &&
	[ "$PINNED_LINT_VERSION" != "$LOCAL_LINT_VERSION" ]; then
	echo "pre-commit: WARNING — golangci-lint $LOCAL_LINT_VERSION does not match the CI pin v$PINNED_LINT_VERSION." >&2
	echo "  A mismatched binary can report formatting in files this commit never touched;" >&2
	echo "  do not reformat those as part of this commit." >&2
	echo "  Match it:  go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v$PINNED_LINT_VERSION" >&2
	echo "  Or, if the newer version is the one we want, bump GOLANGCI_LINT_VERSION in" >&2
	echo "  .github/workflows/ci.yml and commit the reformatting deliberately." >&2
fi

# Lint and CHECK formatting; never fix. Formatting is checked through `run`'s
# formatters (golangci-lint's embedded gofumpt/goimports, never a standalone
# binary, which can pin a different version), so the hook sees exactly what
# CI's lint sees. Two reasons, both from agents sharing one checkout (#545):
#
#   - `--fix` rewrote files AFTER the commit's content had been chosen, so the
#     commit passed while the tree it left behind was dirty, and the rewrite
#     drifted into whichever unrelated commit swept it up next. Failing, and
#     naming the files, lets the author re-stage deliberately.
#   - Without --allow-parallel-runners a peer agent's lint holding the lock made
#     this commit fail with "parallel golangci-lint is running" — contention,
#     not a finding. Lint only reads the tree here, so parallel runs are safe.
#
# `golangci-lint fmt --diff` is deliberately not used: it ignores build tags, so
# it would judge files `run` (and CI) never analyse, and it walks far more.
if ! lint_out="$("$GOLANGCI_LINT" run --allow-parallel-runners ./... 2>&1)"; then
	printf '%s\n' "$lint_out" >&2
	unformatted="$(printf '%s\n' "$lint_out" | grep -E '^[^[:space:]:]+\.go:[0-9]+(:[0-9]+)?: .*\((gofumpt|goimports|gofmt|gci)\)$' | cut -d: -f1 | sort -u || true)"
	if [ -n "$unformatted" ]; then
		echo "pre-commit: these files are not formatted (nothing was changed):" >&2
		printf '%s\n' "$unformatted" | sed 's/^/  /' >&2
		echo "  Fix with: golangci-lint run --fix ./...   then review, stage the files, and commit again." >&2
	fi
	exit 1
fi
# Enforce the ~600-line file-size rule (grandfather baseline in scripts/).
scripts/check-file-size.sh
# Enforce the AGENTS.md brief budget (200 lines / 32 KiB).
scripts/check-agents-brief.sh
# Reject a duplicate CHANGELOG.md version heading.
scripts/check-changelog-headings.sh
